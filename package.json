{
  "name": "portfolio-mcp",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "start:stdio": "bun run src/index.ts -- --stdio",
    "cron": "bun run src/cron/index.ts",
    "typecheck": "tsc --noEmit",
    "test:all-sources": "bun run scripts/all-sources.ts",
    "test:smoke": "bun run scripts/smoke.ts",
    "inspector": "bunx @modelcontextprotocol/inspector bun src/index.ts --stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  }
}
