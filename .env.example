# ── T-Invest (T-Bank brokerage) ───────────────────────────────
TINKOFF_TOKEN=            # token from T-Invest API (Settings -> API tokens)
TINKOFF_ACCOUNT_ID=       # OPTIONAL. Leave empty to auto-discover ALL open accounts.
                          # Set a comma-separated list of ids to restrict, e.g. 2254087513,2306413592

# ── Bybit (read-only) ─────────────────────────────────────────
BYBIT_API_KEY=            # Bybit API key (read-only)
BYBIT_API_SECRET=         # Bybit API secret

# ── Zerion (EVM wallets + EVM DeFi) ───────────────────────────
ZERION_API_KEY=           # Zerion API key (free developer tier)
EVM_WALLET_1=             # 0x... first EVM address
EVM_WALLET_2=             # 0x... second EVM address

# ── Solana ────────────────────────────────────────────────────
SOLANA_WALLET=            # base58 Solana address
HELIUS_API_KEY=           # Helius API key (free tier, 100k req/mo)

# ── Sui (tokens + Bluefin Spot LP) ────────────────────────────
SUI_WALLET=               # Sui address (0x...)

# ── NEAR ──────────────────────────────────────────────────────
NEAR_WALLET=              # near account (example.near)

# ── MCP server (HTTP mode, default) ───────────────────────────
PORT=3000                 # HTTP listen port (omit --stdio to use HTTP)
HOST=127.0.0.1            # bind address; use 0.0.0.0 to expose on LAN
ALLOWED_ORIGINS=*         # CORS for browser clients (Perplexity); comma-separated list

# No keys needed for: MOEX ISS, CBR FX, CoinGecko, Jupiter, Sui/NEAR RPC.
